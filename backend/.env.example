# ---------- 应用 ----------
APP_NAME=AI 作业评审平台
API_PREFIX=/api

# ---------- 数据库 ----------
# 默认落在 backend/data/review.db，改成绝对路径也可以
DATABASE_URL=sqlite:///./data/review.db
# DELETE = 每笔提交直接写主库文件（用数据库工具随时打开都是最新）；
# 想换回 WAL（写入性能更好、但主库文件会滞后）就把这里改成 WAL
SQLITE_JOURNAL_MODE=DELETE

# ---------- 对象存储 ----------
# minio = 使用 MinIO（生产/本地镜像）；local = 存本地磁盘（无 MinIO 时的兜底，便于跑测试）
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=review-platform
MINIO_SECURE=false
# 需要把文件直链给前端时填公网地址，例如 http://localhost:9000
MINIO_PUBLIC_ENDPOINT=
LOCAL_STORAGE_DIR=./data/objects

# ---------- AI 评审 ----------
# mock = 占位评审器（按文件内容稳定出分，方便联调）；llm = 真实大模型（待实现）
AI_REVIEWER=mock
AI_REVIEW_WORKERS=2

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=300

# ---------- i学习 抓取 ----------
# 借本机 Edge 的调试端口读取 i学习 登录态（由「i学习浏览器」启动器打开）
ISTUDY_CDP_PORT=9222

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
