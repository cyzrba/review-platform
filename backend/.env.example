# ============================================================================
#  .env 示例：复制成同目录下的 .env 即可用
#      cp .env.example .env       （Windows: copy .env.example .env）
#
#  什么都不改也能跑：数据库和文件默认落在 backend/data/ 下，跟着项目目录走。
#  要放到别的盘 / 别的目录，就把下面两组路径放开并改成自己的。
# ============================================================================

# ---------- 应用 ----------
APP_NAME=AI 作业评审平台
API_PREFIX=/api

# ---------- 数据库 ----------
# 不填 = backend/data/review.db
# DATABASE_URL=sqlite:///D:/data/review.db
#
# DELETE = 每笔提交直接写主库文件（用数据库工具随时打开都是最新）
# WAL    = 先写 -wal 文件、并发更好，但主库会滞后
SQLITE_JOURNAL_MODE=DELETE

# ---------- 文件存放 ----------
# 不填 = backend/data/objects。抓下来的作业 / 实验报告都在这下面，按「班级-任务名」分文件夹。
# LOCAL_STORAGE_DIR=D:/data/objects

# ---------- AI 评审 ----------
# mock = 占位评审器（不出网、按文件内容稳定出分，方便联调）
# llm  = 真实大模型，要填下面的 key
AI_REVIEWER=llm
AI_REVIEW_WORKERS=2

# ---------- 大模型（OpenAI 兼容接口） ----------
LLM_API_KEY=
# DeepSeek 官方是 https://api.deepseek.com/v1；自建网关就换成网关地址
LLM_BASE_URL=https://api.deepseek.com/v1
# 注意：模型名要按服务商实际支持的填，填错会返回 400
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=180
# 0 = 同一份作答每次给的分都一样，方便复核
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000
LLM_RETRIES=2
# 送模型前把图压一下：长边 1600 字迹照样清楚，费用能降一大截
LLM_IMAGE_MAX_EDGE=1600
LLM_IMAGE_QUALITY=85
# 一次最多给模型看几张图。实验报告是整份 PDF 按页渲染的，一份十几页很常见
LLM_MAX_IMAGES=16
# 关掉模型思考（能省掉几千 token 的无效推理）
LLM_DISABLE_THINKING=true

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=300

# ---------- i学习 抓取 ----------
# 借本机 Edge 的调试端口读取 i学习 登录态（由 start.bat 里的「i学习浏览器」拉起）
ISTUDY_CDP_PORT=9222

# ---------- CORS ----------
# 前端地址变了（换端口 / 局域网访问）就加到这里，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
